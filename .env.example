# Template for the local, git-ignored .env file. Copy it to .env and fill it in.
# Never commit .env. In GCP the same variables come from Secret Manager.

# The environment: its label is shown in the sidebar and it decides the Dimona service.
#   TEST: no Dimona call at all, a fake service answers (use this for local work).
#   ACC:  real calls to the RSZ test service (services-sim.socialsecurity.be).
#   PROD: real calls to the live RSZ service. Never set this locally.
APP_ENV=TEST

# PostgreSQL connection. This value matches the local database of docker-compose.yml (make db).
# The local database holds fake data only (make seed); real data never leaves GCP.
DATABASE_URL=postgresql+psycopg://dimonapp:dimonapp@localhost:5432/dimonapp

# Folder for the uploaded contracts and qualifications (local file storage). It is git-ignored
# and holds fake documents only. In GCP the files go to the Cloud Storage bucket named by
# STORAGE_BUCKET instead; leave that empty locally.
STORAGE_FOLDER=local_storage
STORAGE_BUCKET=

# The Google address that becomes the admin when the admins table is still empty (used for a
# new environment in GCP, see docs/DEPLOYMENT.md). Locally `make seed` adds SEED_ADMIN_EMAIL.
FIRST_ADMIN_EMAIL=

# Google sign-in. Leave empty to run without it: the Google button is then disabled and only
# the username and password form works.
# AUTH_REDIRECT_URI is the application address followed by /oauth2callback
# (locally http://localhost:8501/oauth2callback); AUTH_COOKIE_SECRET is any long random string.
AUTH_REDIRECT_URI=
AUTH_COOKIE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How the fake Dimona service answers every declaration and cancellation: accept, reject or
# timeout. Only read in TEST.
FAKE_DIMONA_OUTCOME=accept

# BMC at the RSZ Dimona service. Only needed in ACC and PROD, which refuse to start without.
# DIMONA_CLIENT_ID: client id of the RSZ channel. DIMONA_ENTERPRISE_NUMBER: KBO/BCE number,
# ten digits. DIMONA_EMPLOYER_ID: RSZ employer number. Joint commissions: XXX ("other")
# is what DimonAPP V2 sends for article 17 and what the RSZ asks for a flexi-job; the RSZ
# refuses 329 as invalid.
DIMONA_CLIENT_ID=
DIMONA_ENTERPRISE_NUMBER=
DIMONA_EMPLOYER_ID=
DIMONA_JOINT_COMMISSION_ARTICLE_17=XXX
DIMONA_JOINT_COMMISSION_FLEXI_JOB=XXX

# The private key registered at the RSZ: exactly one of the PEM text (DIMONA_PRIVATE_KEY, as
# injected from Secret Manager in GCP) and the path of a PEM file OUTSIDE this repository
# (DIMONA_PRIVATE_KEY_PATH, for example ~/Projects/DimonAPP-Secrets/company_key.pem written out
# in full). DIMONA_PRIVATE_KEY_PASSWORD is the passphrase of the key, if any.
DIMONA_PRIVATE_KEY=
DIMONA_PRIVATE_KEY_PATH=
DIMONA_PRIVATE_KEY_PASSWORD=

# Read by `make test-rsz` only (it runs as ACC): national register number of a worker to
# declare and cancel one activity for at the RSZ test service.
RSZ_TEST_NATIONAL_REGISTER_NUMBER=

# Optional, read by `make seed` only, so the fake accounts of the local database can sign in.
# SEED_ADMIN_EMAIL: your own Google address, added as the admin.
# SEED_PASSWORD: password of the fake local workers (camille, noor, robin, alex).
SEED_ADMIN_EMAIL=
SEED_PASSWORD=
